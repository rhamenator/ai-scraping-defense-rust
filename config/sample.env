RUST_LOG=info
WEBHOOK_SHARED_SECRET=dev-secret
CAPTCHA_TOKEN_SECRET=change-me-in-production
CAPTCHA_TOKEN_TTL_SECONDS=300

AI_SERVICE_PORT=8001
ESCALATION_ENGINE_PORT=8002
TARPIT_API_PORT=8003
ADMIN_UI_PORT=8004
CAPTCHA_SERVICE_PORT=8005
CLOUD_DASHBOARD_PORT=8006
CONFIG_RECOMMENDER_PORT=8007
CLOUD_PROXY_PORT=8008
PROMPT_ROUTER_PORT=8009
PUBLIC_BLOCKLIST_PORT=8011
PAY_PER_CRAWL_PORT=8012
EDGE_OPS_PORT=8013
RAG_TRAINER_PORT=8014

ESCALATION_THRESHOLD=0.70
ESCALATION_THROTTLE_THRESHOLD=0.72
ESCALATION_TARPIT_THRESHOLD=0.82
ESCALATION_BLOCK_THRESHOLD=0.92
# Shared model artifact path. rag-trainer writes here when /training/train is
# called with "persist": true; escalation-engine reads it at startup (a path
# with no artifact yet, e.g. a freshly created volume, falls back to
# heuristic detection rather than failing to start) and again on POST
# /admin/reload_model (authorized via ESCALATION_API_KEY/JWT_SECRET, and
# still an error if the artifact is missing or invalid). Both services must
# see the same file; docker-compose backs it with the detection-model named
# volume and defaults to /models/detection-model.json.
#
# rag-trainer is expose-only (not published to the host) and RAG_TRAINER_API_KEY
# must not be shared into another service's environment, so the runtime image
# ships no curl/exec-based shortcut for it. Run the training call through the
# "train-model" ops profile service in docker-compose.yaml, a version-pinned
# curl client scoped to this project's own compose network (no hardcoded
# network name, so it can't collide with an unrelated project's network),
# then reload via escalation-engine's published admin port on the host:
#   docker compose --profile ops run --rm train-model -sS -X POST \
#     http://rag-trainer:8014/training/train -H "Content-Type: application/json" \
#     -H "x-api-key: <RAG_TRAINER_API_KEY>" -d "{...,\"persist\":true}"
#   curl -sS -X POST http://127.0.0.1:8002/admin/reload_model \
#     -H "x-api-key: <ESCALATION_API_KEY>"
# Leave empty outside compose to run with heuristic detection only.
DETECTION_MODEL_PATH=
MAX_LOCAL_TOKENS=2048

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB_BLOCKLIST=0
REDIS_DB_FREQUENCY=0
FREQUENCY_KEY_PREFIX=freq:
FREQUENCY_WINDOW_SECONDS=300

# Cloudflare is an optional ingress/CDN integration. Keep ordinary outbound
# application traffic direct; do not configure Cloudflare as a general HTTP proxy.
ENABLE_GLOBAL_CDN=false
CLOUD_CDN_PROVIDER=cloudflare
# Populate from Cloudflare's published IP ranges when traffic reaches the stack
# through Cloudflare. These peers are trusted to identify the originating IP and
# are never eligible for blocklist insertion.
SECURITY_CDN_TRUSTED_PROXY_CIDRS=
SECURITY_TRUSTED_PROXY_CIDRS=
# Shared random >=32-byte key used by trusted TLS collectors/forwarders.
TLS_FINGERPRINT_ATTESTATION_KEY=
# During rotation only; consumers accept this key but producers never sign with it.
TLS_FINGERPRINT_ATTESTATION_PREVIOUS_KEY=
TLS_FINGERPRINT_ATTESTATION_MAX_AGE_SECONDS=60
CLOUDFLARE_ATTACK_RECOMMENDATION_MIN_REQUESTS=100
CLOUDFLARE_ATTACK_RECOMMENDATION_MIN_BOT_RATIO=0.25

CLOUD_PROXY_URL=http://127.0.0.1:8008/api/chat
LOCAL_MODEL_TARGET=local-inference
CLOUD_MODEL_API_URL=
CLOUD_MODEL_API_KEY=
MODEL_PROVIDER_TIMEOUT_SECONDS=30
MODEL_PROVIDER_MAX_RESPONSE_BYTES=4194304
MODEL_PROVIDER=generic-http
MODEL_NAME=default
ANTHROPIC_VERSION=2023-06-01
# Optional first-party/third-party MCP model proxying. Leave MODEL_URI empty to keep MCP disabled.
MODEL_URI=
MCP_SERVER_PRIMARY_TRANSPORT=ws
MCP_SERVER_PRIMARY_URL=ws://127.0.0.1:8085/mcp
MCP_SERVER_PRIMARY_AUTH_TOKEN=
MCP_SERVER_PRIMARY_TIMEOUT=10
PAYMENT_GATEWAY_URL=
PAYMENT_PROVIDER=generic-http
PAYMENT_API_KEY=
PAYMENT_CURRENCY=usd
PAY_PER_CRAWL_DEFAULT_CHARGE=0.01
PAY_PER_CRAWL_API_KEY=
PAY_PER_CRAWL_MAX_BODY_BYTES=10485760
PAY_PER_CRAWL_MAX_RESPONSE_BYTES=10485760

POSTGRES_ENABLED=true
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=markovdb
PG_USER=markovuser
PG_PASSWORD=markovpass

# Security-event persistence. "auto" uses PostgreSQL when connected and
# falls back to JSONL when PostgreSQL is disabled or unavailable.
AUDIT_STORAGE_BACKEND=auto
AUDIT_JSONL_PATH=data/security-events.jsonl

# Optional OTLP/gRPC trace collector. Leave empty to keep JSON tracing only.
OTEL_EXPORTER_OTLP_ENDPOINT=

ADMIN_API_KEY=
ADMIN_USERNAME=admin
ADMIN_UI_SSO_ENABLED=false
ADMIN_UI_SSO_MODE=oidc
ADMIN_UI_OIDC_ISSUER=
ADMIN_UI_OIDC_AUDIENCE=
ADMIN_UI_OIDC_DISCOVERY_URL=
ADMIN_UI_OIDC_JWKS_URL=
ADMIN_UI_OIDC_ALLOWED_ALGORITHMS=RS256,RS384,RS512,PS256,PS384,PS512,ES256,ES384,EdDSA
ADMIN_UI_OIDC_JWKS_CACHE_SECONDS=300
ADMIN_UI_OIDC_HTTP_TIMEOUT_SECONDS=10
ADMIN_UI_OIDC_CLOCK_SKEW_SECONDS=60
ADMIN_UI_OIDC_REQUIRED_ROLE=
ADMIN_UI_OIDC_REQUIRED_GROUP=
ADMIN_UI_WEBAUTHN_ORIGIN=http://localhost:8004
ADMIN_UI_WEBAUTHN_RP_ID=localhost
ADMIN_UI_WEBAUTHN_RP_NAME=AI Scraping Defense Admin
ADMIN_UI_WEBAUTHN_ADDITIONAL_ORIGINS=
ADMIN_UI_WEBAUTHN_CHALLENGE_TTL_SECONDS=300
ADMIN_UI_SESSION_TTL_SECONDS=3600
ADMIN_UI_SAML_HEADER_USER=X-SSO-User
ADMIN_UI_SAML_HEADER_GROUPS=X-SSO-Groups
ADMIN_UI_SAML_REQUIRED_GROUP=
ESCALATION_API_KEY=
PUBLIC_BLOCKLIST_API_KEY=
EDGE_OPS_API_KEY=
# Required for rag-trainer's /training/* and /finetune/export routes (or use a
# JWT signed with JWT_SECRET). The service denies all training requests when
# neither secret is configured.
RAG_TRAINER_API_KEY=
JWT_SECRET=

EDGE_ALLOWED_DOMAINS=
REAL_BACKEND_HOST=https://example.com
RULES_URL=
CDN_PURGE_URL=
TLS_MANAGER_MODE=external
TLS_CERTIFICATE_SOURCE=deployment
DDOS_PROTECTION_MODE=threshold
